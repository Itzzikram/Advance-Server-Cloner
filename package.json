{
  "name": "discord-advance-cloner",
  "version": "1.0.0",
  "description": "Professional Discord selfbot cloner with TypeScript and http-proxy support",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "serve:dev": "tsx watch src/server.ts",
    "cli": "node dist/index.js",
    "cli:dev": "tsx watch src/index.ts",
    "dev": "tsx watch src/server.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "discord",
    "selfbot",
    "cloner",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@inquirer/prompts": "^8.7.1",
    "axios": "^1.20.0",
    "chalk": "^6.0.0",
    "debug": "^4.4.3",
    "discord-api-types": "^0.38.55",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "http-proxy": "^1.18.1",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^26.4.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
